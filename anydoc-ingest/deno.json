{
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "check": "deno check extensions/models/anydoc_ingest.ts extensions/models/anydoc_ingest_test.ts",
    "lint": "deno lint extensions/models/",
    "fmt": "deno fmt extensions/models/",
    "fmt:check": "deno fmt --check extensions/models/",
    "test": "deno test --allow-env --allow-read --allow-write=/tmp extensions/models/"
  },
  "fmt": {
    "exclude": [
      "CLAUDE.md",
      "AGENTS.md"
    ]
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "imports": {
    "zod": "npm:zod@4.4.3",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@systeminit/swamp-testing": "jsr:@systeminit/swamp-testing@0.20260604.20"
  }
}
