{
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "check": "deno check extensions/reports/*.ts",
    "lint": "deno lint extensions/",
    "fmt": "deno fmt extensions/",
    "fmt:check": "deno fmt --check extensions/",
    "test": "deno test --allow-env --allow-read --allow-net extensions/"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@swamp-club/swamp-testing": "jsr:@swamp-club/swamp-testing@0.20261108.72",
    "@std/assert": "jsr:@std/assert@1.0.19"
  }
}
