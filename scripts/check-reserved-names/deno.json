{
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "scan": "deno run --allow-read main.ts",
    "check": "deno check main.ts main_test.ts lib/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test --allow-read --allow-write --allow-run"
  },
  "fmt": {
    "exclude": [
      "CLAUDE.md",
      "AGENTS.md"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@1",
    "@std/path": "jsr:@std/path@1"
  }
}
